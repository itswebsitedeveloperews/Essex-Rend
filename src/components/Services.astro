---
import Icon from "./Icon.astro";
import ServiceIcon from "./ServiceIcon.astro";
import ResponsiveCarousel from "./ResponsiveCarousel.astro";
const services = [
  {
    title: "Silicon Render",
    copy: "A durable, self-cleaning finish that keeps your property looking great for longer.",
    image: "/images/Silicone-render-1.webp",
    alt: "Silicon render finish on a modern property",
  },
  {
    title: "External Wall Insulation (EWI)",
    copy: "Improve energy efficiency, reduce heating costs and give your home a fresh new look.",
    image: "/images/External-Wall-Insulation-1.webp",
    alt: "External wall insulation being installed",
  },
  {
    title: "Plastering",
    copy: "A smooth, professional finish for new builds, renovations and repairs.",
    image: "/images/Plastering-1.webp",
    alt: "Specialist applying a smooth finish to an exterior wall",
  },
];
---

<section class="services" id="services" aria-labelledby="services-title">
  <div class="container" data-carousel>
    <p class="eyebrow">Our services</p>
    <h2 class="section-title" id="services-title">Expert solutions for every exterior.</h2>
    <p class="services-intro">High quality workmanship, durable materials and finishes designed to protect, enhance and add value to your property.</p>
    <div class="service-grid" data-carousel-track>
      {services.map((service, index) => (
        <article class="service-card">
          <img src={service.image} width="1448" height="1086" alt={service.alt} loading="lazy" />
          <div class="service-body">
            <div class="service-heading">
              <span class="service-icon"><ServiceIcon index={index} /></span>
              <h3>{service.title}</h3>
            </div>
            <p>{service.copy}</p>
            <a href="#contact">Learn More <Icon name="arrow" size={18} stroke="currentColor" /></a>
          </div>
        </article>
      ))}
    </div>
    <ResponsiveCarousel count={services.length} label="Services" />
  </div>
</section>

<style>
  .services { padding: 44px 0 70px; color: var(--ink); background: var(--white); text-align: center; }
  .section-title { margin-top: 14px; }
  .services-intro { margin: 14px auto 0; color: var(--black); font-size: var(--intro-font-size); }
  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 42px; text-align: left; }
  .service-card { border: 1px solid var(--line); background: var(--white); overflow: hidden; }
  .service-card img { width: 100%; height: auto; aspect-ratio: 1.58; object-fit: cover; }
  .service-body { padding: 18px 20px 20px; }
  .service-heading { display: flex; align-items: center; gap: 16px; margin-bottom: 18px; }
  .service-icon { display: inline-flex; flex-shrink: 0; color: var(--service-icon-color); }
  h3 { margin: 0; font-size: var(--body-lead-font-size); line-height: 1.3; }
  .service-body p { min-height: 48px; margin: 0 0 16px; color: var(--copy); font-size: var(--body-font-size); }
  .service-body a { display: inline-flex; align-items: center; gap: 16px; color: var(--accent); font-size: var(--button-font-size); font-weight: 500; transition: color 180ms ease; }
  .service-body a:hover, .service-body a:focus-visible { color: var(--ink); }
  @media (max-width: 1024px) {
    .service-grid { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .service-grid::-webkit-scrollbar { display: none; }
    .service-card { flex: 0 0 calc((100% - 16px) / 2); scroll-snap-align: start; }
    .service-card img { aspect-ratio: 1.15; }
  }
  @media (max-width: 700px) {
    .services { padding: 0 0 54px; }
    .services-intro { font-size: var(--body-font-size); }
    .service-grid { width: 100%; margin-top: 30px; padding: 0; }
    .service-card { flex-basis: 100%; }
    .service-card img { aspect-ratio: 1.4; }
  }
  @media (max-width: 360px) {
    .service-grid { width: 100%; }
  }
</style>