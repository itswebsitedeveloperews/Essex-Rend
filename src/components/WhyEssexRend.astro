---
import Icon from "./Icon.astro";
const features = [
  ["Specialist workmanship", "15 years’ experience in achieving a quality finish.", "badge"],
  ["Clear communication", "Keep informed throughout your project.", "chat"],
  ["Specialist workmanship", "A clean, efficient service with care at every stage.", "home-heart"],
];
---

<section class="why" id="why-essex-rend" aria-labelledby="why-title">
  <div class="container why-grid">
    <div class="why-content">
      <p class="eyebrow">Why Essex Rend</p>
      <h2 class="section-title" id="why-title">Care in the details. Pride in the finish.</h2>
      <p class="why-intro">Specialist silicon rendering, quality materials and a clean, efficient service – with clear communication from start to finish.</p>
      <div class="feature-list">
        {features.map(([title, copy, icon]) => (
          <article>
            <Icon name={icon} size={56} stroke="var(--accent)" />
            <div>
              <h3>{title}</h3>
              <p>{copy}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="why-actions">
        <a class="button" href="#contact">Request A Quote <Icon name="arrow" size={18} stroke="currentColor" /></a>
        <div class="insured"><Icon name="shield" size={18} stroke="currentColor" /><span>Fully Insured</span></div>
      </div>
    </div>
    <div class="why-media">
      <img src="/images/rendering_worker_3x.webp" width="1200" height="793" alt="Rendering specialist applying a clean exterior finish" loading="lazy" />
      <div class="stat">
        <strong>15</strong>
        <span>years<br />experience</span>
      </div>
    </div>
  </div>
</section>

<style>
  .why { padding: 100px 0; }
  .why-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 120px; align-items: stretch; }
  .section-title { margin-top: 16px; }
  .why-intro { max-width: 660px; margin: 22px 0 48px; color: var(--ink); font-size: var(--body-font-size); }
  .feature-list { display: grid; margin-bottom: 50px; }
  .feature-list article { display: flex; gap: 14px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--line); }
  h3 { margin: 0 0 10px; font-size: var(--body-font-size); }
  .feature-list p { margin: 0; color: var(--copy); font-size: var(--small-font-size); }
  .why-media { position: relative; }
  .why-media img { width: 100%; height: 100%; aspect-ratio: 1.15; object-fit: cover; }
  .stat { position: absolute; right: 22px; bottom: 22px; display: flex; align-items: center; gap: 8px; padding: 28px 24px; color: var(--accent); background: var(--white); }
  .stat strong { font-size: var(--stat-font-size); line-height: 1; }
  .stat span { font-size: var(--small-font-size); line-height: 1.1; }
  .why-actions { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; }
  .insured { display: flex; align-items: center; gap: 8px; font-size: var(--small-font-size); }
  .insured :global(svg) { width: 18px; height: 18px; flex-shrink: 0; }
  .feature-list :global(svg) { width: 56px; height: 56px; flex-shrink: 0; }
  @media (max-width: 991px) {
    .why { padding: 70px 0; }
    .why-grid { grid-template-columns: 1fr; gap: 50px; }
  }
  @media (max-width: 767px) {
    .why { padding: 54px 0; }
    .why-intro { margin-bottom: 24px; }
    .why-media img { height: auto; }
    .stat { padding: 18px 20px; }
    .feature-list { margin-bottom: 32px; }
  }
</style>