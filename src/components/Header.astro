---
import Icon from "./Icon.astro";
---

<header class="site-header">
  <div class="utility">
    <div class="container utility-inner">
      <a href="tel:+447498328113"><Icon name="phone" size={14} stroke="var(--accent)" />07498 328113</a>
      <span class="utility-divider" aria-hidden="true"></span>
      <a href="mailto:info@essexrend.co.uk"><Icon name="mail" size={16} stroke="var(--accent)" />info@essexrend.co.uk</a>
      <span class="utility-divider" aria-hidden="true"></span>
      <span>Serving Essex, London &amp; surrounding areas</span>
    </div>
  </div>
  <div class="navigation">
    <div class="container navigation-inner">
      <a class="logo" href="#silicon-render" aria-label="Essex Rend home">
        <img src="/images/essex-rend-logo.svg" width="117" height="86" alt="Essex Rend" />
      </a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a class="active" href="#silicon-render">Silicon Render</a>
        <a href="#why-essex-rend">Why Essex Rend</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="button header-quote" href="#contact">Request A Quote <Icon name="arrow" size={18} stroke="currentColor" /></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span class="menu-open-icon"><Icon name="menu" stroke="var(--white)" /></span>
        <span class="menu-close-icon"><Icon name="close" stroke="var(--white)" /></span>
      </button>
    </div>
    <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation" aria-hidden="true">
      <a href="#silicon-render">Silicon Render</a>
      <a href="#why-essex-rend">Why Essex Rend</a>
      <a href="#services">Services</a>
      <a href="#contact">Contact</a>
      <a href="#contact">Request A Quote</a>
      <div class="mobile-contact">
        <a href="tel:+447498328113">07498 328113</a>
        <a href="mailto:info@essexrend.co.uk">info@essexrend.co.uk</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  const pageContent = document.querySelectorAll<HTMLElement>("main, footer");
  let lastFocused: HTMLElement | null = null;
  const closeMenu = () => {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Open menu");
    menu.setAttribute("aria-hidden", "true");
    document.body.classList.remove("menu-open");
    pageContent.forEach((element) => element.removeAttribute("inert"));
    lastFocused?.focus();
  };
  const openMenu = () => {
    if (!toggle || !menu) return;
    lastFocused = document.activeElement as HTMLElement;
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Close menu");
    menu.setAttribute("aria-hidden", "false");
    document.body.classList.add("menu-open");
    pageContent.forEach((element) => element.setAttribute("inert", ""));
    menu.querySelector<HTMLElement>("a")?.focus();
  };
  toggle?.addEventListener("click", () => {
    toggle.getAttribute("aria-expanded") === "true" ? closeMenu() : openMenu();
  });
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
    if (event.key === "Tab" && menu?.getAttribute("aria-hidden") === "false") {
      const focusable = [...menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
  window.addEventListener("resize", () => {
    if (window.innerWidth > 991) closeMenu();
  });
</script>

<style>
  .site-header { color: var(--white); background: var(--ink); }
  .utility { height: 36px; border-bottom: 1px solid var(--white-18); }
  .utility-inner { height: 100%; display: flex; align-items: center; justify-content: flex-end; gap: 12px; font-size: var(--small-font-size); }
  .utility a { display: inline-flex; align-items: center; gap: 9px; transition: color 180ms ease; }
  .utility a:hover { color: var(--accent); }
  .utility-divider { width: 1px; height: 18px; background: var(--white-65); }
  .navigation { position: relative; z-index: 30; }
  .navigation-inner { height: 107px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
  .logo { justify-self: start; }
  .logo img { width: 117px; height: auto; }
  .desktop-nav { display: flex; align-items: center; gap: 20px; }
  .desktop-nav a { position: relative; padding: 18px 10px; font-weight: 600; }
  .desktop-nav a::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: 7px; height: 3px; background: var(--white); transform: scaleX(0); transition: transform 180ms ease; }
  .desktop-nav a:hover::after, .desktop-nav a.active::after { transform: scaleX(1); }
  .header-quote { justify-self: end; min-width: 188px; }
  .header-quote:hover { color: var(--accent); }
  .menu-toggle, .mobile-menu { display: none; }

  @media (max-width: 991px) {
    .utility { display: none; }
    .navigation-inner { height: 82px; grid-template-columns: 1fr auto; }
    .logo img { width: 104px; }
    .desktop-nav, .header-quote { display: none; }
    .menu-toggle { display: grid; place-items: center; width: 48px; height: 48px; padding: 0; border: 0; color: var(--white); background: transparent; cursor: pointer; }
    .menu-close-icon { display: none; }
    .menu-toggle[aria-expanded="true"] .menu-open-icon { display: none; }
    .menu-toggle[aria-expanded="true"] .menu-close-icon { display: block; }
    .mobile-menu { position: fixed; inset: 82px 0 0; display: flex; flex-direction: column; align-items: stretch; padding: 28px 20px; color: var(--white); background: var(--ink); transform: translateX(100%); opacity: 0; visibility: hidden; transition: transform 240ms ease, opacity 240ms ease, visibility 240ms; }
    .mobile-menu[aria-hidden="false"] { transform: translateX(0); opacity: 1; visibility: visible; }
    .mobile-menu > a { padding: 16px 4px; border-bottom: 1px solid var(--white-16); font-size: var(--body-lead-font-size); font-weight: 600; }
    .mobile-menu > a:hover { color: var(--accent); }
    .mobile-contact { display: grid; gap: 10px; margin-top: 30px; color: var(--white-75); font-size: var(--small-font-size); }
  }
</style>