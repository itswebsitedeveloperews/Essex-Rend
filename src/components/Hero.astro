---
import Icon from "./Icon.astro";
---

<section class="hero" id="silicon-render">
  <div class="container hero-inner">
    <p class="eyebrow">Silicon Render Specialists</p>
    <h1>A fresh finish.<br />A lasting impression.</h1>
    <p class="hero-copy">Specialist silicon rendering across Essex, London and surrounding areas.</p>
    <div class="hero-actions">
      <a class="button" href="#contact">Request A Quote <Icon name="arrow" size={18} stroke="currentColor" /></a>
      <a class="phone-link" href="tel:+447498328113"><Icon name="phone" size={16} stroke="currentColor" />07498 328113</a>
    </div>
  </div>
</section>

<style>
  .hero { padding: 44px 0 42px; text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; }
  h1 { margin: 18px 0 16px; font-size: var(--hero-font-size); font-weight: 700; letter-spacing: -.055em; line-height: 1.06; }
  .hero-copy { margin: 0; color: var(--muted-text); font-size: var(--body-lead-font-size); line-height: 30px; }
  .hero-actions { display: flex; align-items: center; gap: 18px; margin-top: 34px; }
  .phone-link { display: inline-flex; align-items: center; gap: 12px; padding: 12px 14px; font-weight: 500; transition: color 180ms ease; }
  .phone-link:hover { color: var(--accent); }
  @media (max-width: 1024px) {
    .hero { padding: clamp(38px, 7vw, 58px) 0 clamp(44px, 8vw, 76px); }
    h1 { margin-top: 15px; font-size: clamp(48px, 8vw, 76px); line-height: 1.02; }
    .hero-copy { max-width: 340px; font-size: var(--body-font-size); line-height: 24px; }
    .hero-actions { flex-direction: column; gap: 4px; margin-top: 28px; }
  }
  @media (max-width: 480px) {
    .hero { padding: 32px 0 40px; }
    .hero h1 { max-width: 330px; font-size: var(--mobile-hero-font-size); }
    .hero-copy { max-width: 310px; }
    .hero-actions { flex-direction: row; gap: 8px; margin-top: 28px; }
    .hero-actions .button { width: auto; padding-inline: 14px; }
    .phone-link { gap: 8px; padding: 12px 0; font-size: var(--small-font-size); white-space: nowrap; }
  }
</style>