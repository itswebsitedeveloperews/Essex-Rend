---
import ResponsiveCarousel from "./ResponsiveCarousel.astro";
const items = [
  { image: "/images/rendered_house_3x.webp", width: 1200, height: 800, label: "Fresh exteriors", alt: "Freshly rendered detached house exterior" },
  { image: "/images/modern_rendered_extension_3x.webp", width: 1200, height: 800, label: "Modern detailing", alt: "Modern rendered home extension" },
  { image: "/images/rendered_window_3x.webp", width: 1200, height: 793, label: "A finish that suits your home", alt: "Close-up of a rendered wall and window" },
];
---

<section class="possibilities" aria-labelledby="possibilities-title">
  <div class="container" data-carousel>
    <div class="heading-rule">
      <h2 id="possibilities-title">Picture the possibilities.</h2>
      <span aria-hidden="true"></span>
    </div>
    <div class="possibilities-grid" data-carousel-track>
      {items.map((item) => (
        <figure>
          <img src={item.image} width={item.width} height={item.height} alt={item.alt} loading="eager" />
          <figcaption>{item.label}</figcaption>
        </figure>
      ))}
    </div>
    <ResponsiveCarousel count={items.length} label="Possibilities" />
    <p class="disclaimer">Illustrative finishes — not completed Essex Rend projects.</p>
  </div>
</section>

<style>
  .possibilities { padding: 42px 0 72px; }
  .heading-rule { display: flex; align-items: center; gap: 18px; }
  h2 { margin: 0; flex: 0 0 auto; font-size: var(--heading-font-size); letter-spacing: -.045em; line-height: 1.1; }
  .heading-rule span { width: 100%; height: 1px; background: var(--accent); }
  .possibilities-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 50px 0; }
  figure { margin: 0; }
  figure img { width: 100%; height: clamp(320px, 31vw, 500px); object-fit: cover; }
  figcaption { margin-top: 16px; font-size: var(--intro-font-size); font-weight: 700; }
  .disclaimer { margin: 0 auto; text-align: center; color: var(--muted-text); font-size: var(--small-font-size); }
  @media (max-width: 1024px) {
    .possibilities { padding: 34px 0 50px; overflow: hidden; }
    .heading-rule { align-items: flex-end; gap: 12px; }
    h2 { max-width: 290px; font-size: var(--mobile-heading-font-size); }
    .possibilities-grid { display: flex; gap: 16px; width: 100%; margin: 30px 0 0; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .possibilities-grid::-webkit-scrollbar { display: none; }
    figure { flex: 0 0 calc((100% - 16px) / 2); scroll-snap-align: start; }
    figure img { height: auto; aspect-ratio: .82; }
    .disclaimer { max-width: 430px; margin-top: 20px; font-size: var(--eyebrow-font-size); }
  }
  @media (max-width: 700px) {
    .possibilities { padding-top: 0; }
    .heading-rule { width: 100%; max-width: 100%; }
    .heading-rule span { display: none; }
  }
  @media (max-width: 480px) {
    h2 { font-size: var(--mobile-heading-font-size); }
    figure { flex-basis: 100%; }
    figure img { height: auto; aspect-ratio: .8; }
  }
</style>