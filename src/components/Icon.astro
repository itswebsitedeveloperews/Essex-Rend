---
const { name, size = 20, stroke = "currentColor" } = Astro.props;
---

{name === "arrow" && (
  <svg width={size} height={size} viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <path d="M13.5 6L16.5 9L13.5 12M1.5 9H16.5" stroke={stroke} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === "phone" && (
  <svg width={size} height={size} viewBox="0 0 14 15" fill="none" aria-hidden="true">
    <path d="M2.925.675l2.25 3-1.5 1.5c.975 2.25 2.775 4.05 5.025 5.025l1.5-1.5 3 2.25c-.375 1.65-1.35 2.475-2.925 2.475C5.625 13.425.675 8.475.675 2.325.675.975 1.425.675 2.925.675Z" stroke={stroke} stroke-width="1.35" />
  </svg>
)}
{name === "mail" && (
  <svg width={size} height={size} viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path d="M16.667 4.167H3.333c-.46 0-.833.373-.833.833v10c0 .46.373.833.833.833h13.334c.46 0 .833-.373.833-.833V5c0-.46-.373-.833-.833-.833Z" stroke={stroke} stroke-width="1.5" />
    <path d="m2.5 5.833 7.5 5.834 7.5-5.834" stroke={stroke} stroke-width="1.5" />
  </svg>
)}
{name === "menu" && (
  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
    <path d="M4 8h20M4 14h20M4 20h20" stroke={stroke} stroke-width="1.6" stroke-linecap="round" />
  </svg>
)}
{name === "close" && (
  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
    <path d="m6 6 16 16M22 6 6 22" stroke={stroke} stroke-width="1.6" stroke-linecap="round" />
  </svg>
)}
{name === "badge" && (
  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <path d="m25.795 21.483 2.525 14.21a.834.834 0 0 1-1.35.784l-5.968-4.478a1.667 1.667 0 0 0-2 0l-5.971 4.477a.834.834 0 0 1-1.35-.783l2.523-14.21" stroke={stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="20" cy="13.333" r="10" stroke={stroke} stroke-width="2" />
  </svg>
)}
{name === "chat" && (
  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <path d="M35.088 27.622a3.018 3.018 0 0 1-3.018 3.018H12.197a3.018 3.018 0 0 0-2.133.884l-3.322 3.322a.834.834 0 0 1-1.422-.59V9.517A3.018 3.018 0 0 1 8.339 6.5h23.731a3.018 3.018 0 0 1 3.018 3.017v18.105Z" stroke={stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M20 18.57h.016M26.035 18.57h.016M13.965 18.57h.015" stroke={stroke} stroke-width="2" stroke-linecap="round" />
  </svg>
)}
{name === "home" && (
  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <path d="M5 16.666 17.85 4.12a3.333 3.333 0 0 1 4.3 0L35 16.666v15a3.333 3.333 0 0 1-3.333 3.334H8.333A3.333 3.333 0 0 1 5 31.666v-15Z" stroke={stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M15 35V25h10v10" stroke={stroke} stroke-width="2" stroke-linecap="round" />
  </svg>
)}
{name === "shield" && (
  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <path d="M20 35s12-5.833 12-15V7.5L20 3 8 7.5V20c0 9.167 12 15 12 15Z" stroke={stroke} stroke-width="2" stroke-linejoin="round" />
    <path d="m14 20 4 4 8-9" stroke={stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === "calendar" && (
  <svg width="60" height="60" viewBox="0 0 60 60" fill="none" aria-hidden="true">
    <path d="M47.5 12.5h-35A2.5 2.5 0 0 0 10 15v32.5a2.5 2.5 0 0 0 2.5 2.5h35a2.5 2.5 0 0 0 2.5-2.5V15a2.5 2.5 0 0 0-2.5-2.5ZM20 7.5v10M40 7.5v10M10 22.5h40M20 30h5m5 0h5m5 0h5m-25 10h5m5 0h5" stroke={stroke} stroke-width="3" />
  </svg>
)}