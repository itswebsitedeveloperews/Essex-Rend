---
import BenefitIcon from "./BenefitIcon.astro";

const benefits = [
  ["Fresh Exteriors", "A consistent finish with lasting visual appeal."],
  ["Low Maintenance", "Less routine upkeep for your exterior."],
  ["Flexible Finish", "A consistent finish with lasting visual appeal."],
  ["Weather Resistant", "A consistent finish with lasting visual appeal."],
  ["EWI Compatible", "Suitable for compatible external wall insulation systems."],
  ["Breathable", "Allows moisture vapour to escape."],
];
---

<section class="benefits" aria-labelledby="benefits-title">
  <div class="container">
    <p class="eyebrow">The finish makes the difference</p>
    <h2 class="section-title" id="benefits-title">More than a modern exterior.</h2>
    <p class="intro">A versatile finish that combines a fresh look with practical everyday benefits.</p>
    <div class="benefit-grid">
      {benefits.map(([title, copy], index) => (
        <article class="benefit">
          <span class="benefit-icon"><BenefitIcon index={index} /></span>
          <h3>{title}</h3>
          <p>{copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .benefits { padding: 44px 0 70px; background: var(--white); text-align: center; }
  .section-title { margin-top: 14px; }
  .intro { margin: 14px auto 0; color: var(--black); font-size: var(--intro-font-size); line-height: 22px; }
  .benefit-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 52px; }
  .benefit { min-height: 210px; padding: 40px 24px; border-right: 1px solid var(--line); }
  .benefit:nth-child(3n) { border-right: 0; }
  .benefit:nth-child(-n + 3) { border-bottom: 1px solid var(--line); }
  .benefit-icon { display: inline-flex; color: var(--accent); vertical-align: top; }
  .benefit h3 { margin: 15px 0; font-size: var(--body-font-size); }
  .benefit p { margin: 0; color: var(--muted-text); font-size: var(--small-font-size); }
  @media (max-width: 1024px) {
    .benefits { padding: 54px 0 50px; }
    .intro { font-size: var(--body-font-size); line-height: 24px; }
    .benefit-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 30px; }
    .benefit { min-height: 0; padding: 28px 22px; border-right: 0; border-bottom: 1px solid var(--line); }
    .benefit:nth-child(odd) { border-right: 1px solid var(--line); }
    .benefit:nth-child(3n) { border-right: 1px solid var(--line); }
    .benefit:nth-child(2n) { border-right: 0; }
    .benefit:nth-last-child(-n + 2) { border-bottom: 0; }
  }
  @media (max-width: 560px) {
    .benefit-grid { grid-template-columns: 1fr; }
    .benefit, .benefit:nth-child(odd), .benefit:nth-child(3n) { border-right: 0; border-bottom: 1px solid var(--line); }
    .benefit:last-child { border-bottom: 0; }
  }
</style>