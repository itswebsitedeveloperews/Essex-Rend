---
const { count, label } = Astro.props;
---

<div class="carousel-controls" aria-label={`${label} slider controls`}>
  <div class="carousel-dots" aria-label="Choose slide">
    {Array.from({ length: count }, (_, index) => (
      <button
        type="button"
        data-carousel-dot={index}
        class:list={{ active: index === 0 }}
        aria-label={`Show slide ${index + 1}`}
        aria-current={index === 0 ? "true" : "false"}
      ></button>
    ))}
  </div>
  <div class="carousel-arrows">
    <button type="button" data-carousel-previous aria-label="Previous slide">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="m11 4-5 5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button type="button" data-carousel-next aria-label="Next slide">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="m7 4 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>
</div>

<script>
  const setupCarousels = () => {
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
      if (carousel.dataset.carouselReady === "true") return;
      carousel.dataset.carouselReady = "true";

      const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
      const cards = [...(track?.children ?? [])] as HTMLElement[];
      const dots = [...carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]")];
      const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-previous]");
      const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
      if (!track || !cards.length || !previous || !next) return;

      let page = 0;
      const visibleCards = () => window.matchMedia("(max-width: 700px)").matches ? 1 : 2;
      const lastPage = () => Math.max(0, cards.length - visibleCards());
      const step = () => cards[0].getBoundingClientRect().width + Number.parseFloat(getComputedStyle(track).gap || "0");

      const update = (scroll = false) => {
        page = Math.min(page, lastPage());
        dots.forEach((dot, index) => {
          dot.hidden = index > lastPage();
          dot.classList.toggle("active", index === page);
          dot.setAttribute("aria-current", index === page ? "true" : "false");
        });
        previous.disabled = page === 0;
        next.disabled = page === lastPage();
        if (scroll) track.scrollTo({ left: page * step(), behavior: "smooth" });
      };

      previous.addEventListener("click", () => {
        page = Math.max(0, page - 1);
        update(true);
      });
      next.addEventListener("click", () => {
        page = Math.min(lastPage(), page + 1);
        update(true);
      });
      dots.forEach((dot, index) => dot.addEventListener("click", () => {
        page = Math.min(index, lastPage());
        update(true);
      }));
      let frame = 0;
      track.addEventListener("scroll", () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          page = Math.min(lastPage(), Math.max(0, Math.round(track.scrollLeft / step())));
          update();
        });
      }, { passive: true });
      window.addEventListener("resize", () => update(true));
      update();
    });
  };

  setupCarousels();
  document.addEventListener("astro:page-load", setupCarousels);
</script>

<style>
  .carousel-controls { display: none; }
  @media (max-width: 1024px) {
    .carousel-controls { display: flex; align-items: center; justify-content: space-between; margin-top: 34px; }
    .carousel-dots { display: flex; align-items: center; gap: 8px; }
    .carousel-dots button { width: 8px; height: 8px; padding: 0; border: 0; border-radius: 999px; background: var(--line); cursor: pointer; transition: width 180ms ease, background-color 180ms ease; }
    .carousel-dots button.active { width: 36px; background: var(--accent); }
    .carousel-arrows { display: flex; gap: 10px; }
    .carousel-arrows button { display: grid; place-items: center; width: 42px; height: 42px; padding: 0; border: 1px solid var(--line); border-radius: 50%; color: var(--ink); background: var(--white); cursor: pointer; transition: color 180ms ease, border-color 180ms ease; }
    .carousel-arrows button:hover:not(:disabled), .carousel-arrows button:focus-visible:not(:disabled) { color: var(--accent); border-color: var(--accent); }
    .carousel-arrows button:disabled { color: var(--line); cursor: default; }
  }
</style>